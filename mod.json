{
	"geode": "6.0.0-alpha.2",
	"gd": {
		"win": "2.2091",
		"android": "2.2091",
		"mac": "2.2091",
		"ios": "2.2091"
	},
	"id": "local.practice-hud",
	"name": "Practice Suite",
	"version": "v3.2.0",
	"developer": "local",
	"description": "Floating config menu, customizable HUD (FPS/CPS/images), practice music, noclip, speedhack, hitboxes, unlocks and safe mode. English / Español.",
	"tags": [
		"utility",
		"interface",
		"gameplay"
	],
	"settings": {
		"t-general": {
			"type": "title",
			"name": "General"
		},
		"language": {
			"type": "string",
			"name": "Language",
			"default": "English",
			"one-of": [
				"English",
				"Español"
			],
			"description": "Language of the in-game menu and HUD."
		},
		"ball-enabled": {
			"type": "bool",
			"name": "Floating ball",
			"default": true,
			"description": "Shows the draggable ball that opens the config menu. If you turn it off, you can only change settings here."
		},
		"ball-hide-ingame": {
			"type": "bool",
			"name": "Hide ball while playing",
			"default": true,
			"description": "The ball reappears when you pause."
		},
		"t-practice": {
			"type": "title",
			"name": "Practice"
		},
		"practice-music": {
			"type": "bool",
			"name": "Practice music",
			"default": true,
			"description": "Level music plays and stays synced in practice mode."
		},
		"auto-practice": {
			"type": "bool",
			"name": "Auto practice",
			"default": false,
			"description": "Enters practice mode as soon as the level starts."
		},
		"no-death-effect": {
			"type": "bool",
			"name": "No death effect",
			"default": false,
			"description": "Removes the death explosion (respawn is faster)."
		},
		"t-cheats": {
			"type": "title",
			"name": "Cheats"
		},
		"safe-mode": {
			"type": "bool",
			"name": "Safe mode",
			"default": true,
			"description": "If you used cheats in an attempt, the game treats it as a test run: no progress is saved and the level is not truly completed."
		},
		"noclip": {
			"type": "bool",
			"name": "Noclip",
			"default": false,
			"description": "Pass through obstacles without dying."
		},
		"noclip-p1": {
			"type": "bool",
			"name": "Noclip player 1",
			"default": true
		},
		"noclip-p2": {
			"type": "bool",
			"name": "Noclip player 2",
			"default": true
		},
		"speedhack-on": {
			"type": "bool",
			"name": "Speedhack",
			"default": false,
			"description": "Changes the game speed. Keep it off when opening the game."
		},
		"speedhack": {
			"type": "float",
			"name": "Speed",
			"default": 1.0,
			"min": 0.1,
			"max": 5.0,
			"control": {
				"input": true,
				"slider": true
			},
			"description": "1.0 = normal. Lower is slower."
		},
		"t-hitbox": {
			"type": "title",
			"name": "Hitboxes"
		},
		"show-hitboxes": {
			"type": "bool",
			"name": "Show hitboxes",
			"default": false,
			"description": "Draws collision boxes of the player and objects."
		},
		"hitbox-solids": {
			"type": "bool",
			"name": "Solids (blue)",
			"default": true
		},
		"hitbox-hazards": {
			"type": "bool",
			"name": "Hazards (red)",
			"default": true
		},
		"hitbox-others": {
			"type": "bool",
			"name": "Others (green)",
			"default": false,
			"description": "Portals, orbs, pads... May lower FPS."
		},
		"hitbox-fill": {
			"type": "float",
			"name": "Fill",
			"default": 0.25,
			"min": 0.0,
			"max": 1.0,
			"control": {
				"input": true,
				"slider": true
			}
		},
		"t-bypass": {
			"type": "title",
			"name": "Bypass"
		},
		"unlock-icons": {
			"type": "bool",
			"name": "Unlock icons and colors",
			"default": false,
			"description": "All icons, colors and trails (local only)."
		},
		"unlock-shops": {
			"type": "bool",
			"name": "Unlock shops",
			"default": false,
			"description": "Opens the secret shops."
		},
		"unlock-main-levels": {
			"type": "bool",
			"name": "Unlock main levels",
			"default": false,
			"description": "Removes the coin requirement of main levels."
		},
		"char-limit": {
			"type": "bool",
			"name": "No character limit",
			"default": false,
			"description": "Removes the text limit of in-game text fields."
		},
		"t-hud": {
			"type": "title",
			"name": "HUD"
		},
		"show-hud": {
